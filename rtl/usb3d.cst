// usb3d pin constraints for SLogic16U3 (GW5AT-LV15MG132C1): USB 3.0 side as in ciniml's reference, trace on CH8..CH12.
IO_LOC "usb_cmp_dp" H3,H2;
IO_PORT "usb_cmp_dp" IO_TYPE=LVDS25 PULL_MODE=NONE DIFF_RESISTOR=OFF;
IO_LOC "usb_cmp_dn" M2,M1;
IO_PORT "usb_cmp_dn" IO_TYPE=LVDS25 PULL_MODE=NONE DIFF_RESISTOR=OFF;
IO_LOC "usb_pullup" C14;
IO_PORT "usb_pullup" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "xo_en" D14;
IO_PORT "xo_en" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led_r" G14;
IO_PORT "led_r" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "usb_dxp" K3;
IO_PORT "usb_dxp" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "usb_dxn" K2;
IO_PORT "usb_dxn" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "usb_tdp" P2;
IO_PORT "usb_tdp" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "usb_tdn" P1;
IO_PORT "usb_tdn" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
// CH8..CH11: TRACED0..3, CH12 (N9, GCLKT_2): TRACECLK. LVCMOS15UD33: ~0.75 V threshold behind the ~0.47 input dividers.
IO_LOC "ch[8]" N11;
IO_PORT "ch[8]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "ch[9]" P11;
IO_PORT "ch[9]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "ch[10]" N10;
IO_PORT "ch[10]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "ch[11]" P10;
IO_PORT "ch[11]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
IO_LOC "ch[12]" N9;
IO_PORT "ch[12]" IO_TYPE=LVCMOS15UD33 PULL_MODE=NONE;
